{
  "name": "dotmatrix",
  "version": "1.0.0",
  "description": "Nadeldrucker Emulator — Dot-Matrix Print Effect",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "serve": "python3 -m http.server 8080",
    "dev:server": "nodemon server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "setup:admin": "node server/db/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^4.0.9",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
