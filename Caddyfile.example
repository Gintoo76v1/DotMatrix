app.alireda.co {
    # ── API: Proxy zu Node.js (strip /dotmatrix-Prefix vor Weiterleitung) ────
    # MUSS vor handle_path /dotmatrix* stehen, sonst greift der file_server zuerst.
    handle /dotmatrix/api/* {
        uri strip_prefix /dotmatrix
        reverse_proxy localhost:3000
    }

    # ── WebSocket: Proxy zu Node.js ───────────────────────────────────────────
    handle /dotmatrix/ws {
        uri strip_prefix /dotmatrix
        reverse_proxy localhost:3000
    }

    # ── Statische Dateien ─────────────────────────────────────────────────────
    handle_path /dotmatrix* {
        root * /path/to/dotmatrix/repo  # TODO: Pfad auf dem Server anpassen
        file_server

        # Security Headers
        header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "SAMEORIGIN"
        header Referrer-Policy "strict-origin-when-cross-origin"

        # JS/CSS/Fonts/Bilder: aggressiv cachen (immutable)
        @static {
            path *.js *.css *.woff2 *.png *.json
        }
        header @static Cache-Control "public, max-age=31536000, immutable"

        # HTML nie cachen, damit Updates sofort sichtbar sind
        @html {
            path *.html
        }
        header @html Cache-Control "no-cache, no-store, must-revalidate"
    }
}
